!
! {{ inventory_hostname }} ({{ device_type }}) - generated by Ansible
! Source of truth: host_vars/{{ inventory_hostname }}.yml
!
hostname {{ inventory_hostname }}
!
no ip domain lookup
!
{% if device_type == 'switch' %}
{% for vlan in vlans %}
vlan {{ vlan.id }}
 name {{ vlan.name }}
!
{% endfor %}
{% endif %}
{% for intf in interfaces %}
interface {{ intf.name }}
{% if intf.description is defined %}
 description {{ intf.description }}
{% endif %}
{% if intf.ipv4 is defined %}
 ip address {{ intf.ipv4 }} {{ intf.mask }}
{% if intf.ospf is defined %}
 ip ospf {{ ospf.process }} area {{ intf.ospf.area }}
{% endif %}
{% endif %}
{% if intf.mode is defined %}
{% if intf.mode == 'access' %}
 switchport mode access
 switchport access vlan {{ intf.access_vlan }}
 spanning-tree portfast
{% elif intf.mode == 'trunk' %}
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk allowed vlan {{ intf.trunk_vlans }}
{% endif %}
{% endif %}
 no shutdown
!
{% endfor %}
{% if device_type == 'switch' and mgmt_svi is defined %}
interface Vlan{{ mgmt_svi.vlan }}
 description Management SVI
 ip address {{ mgmt_svi.ipv4 }} {{ mgmt_svi.mask }}
 no shutdown
!
ip default-gateway {{ mgmt_svi.gateway }}
!
{% endif %}
{% if device_type == 'router' and ospf is defined %}
router ospf {{ ospf.process }}
 router-id {{ ospf.router_id }}
!
{% endif %}
{% if snmp is defined %}
snmp-server community {{ snmp.community }} {{ 'RO' if snmp.access == 'ro' else 'RW' }}
snmp-server location {{ snmp.location }}
snmp-server contact {{ snmp.contact }}
!
{% endif %}
end
